# Environment Variables — "Hiện Sinh" Gallery
# Sao chép file này thành .env.local và điền các giá trị tương ứng
# KHÔNG commit file .env.local lên Git

# ─────────────────────────────────────────────
# SUPABASE (Backend Oracle Proxy & Database)
# Lấy từ: Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# SMART CONTRACT (Base Network)
# Điền sau khi đã deploy contract
# ─────────────────────────────────────────────
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=8453
# Base Sepolia Testnet = 84532, Base Mainnet = 8453

# ─────────────────────────────────────────────
# WALLETCONNECT PROJECT ID (Web3 Auth)
# Lấy miễn phí tại: https://cloud.walletconnect.com
# ─────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
